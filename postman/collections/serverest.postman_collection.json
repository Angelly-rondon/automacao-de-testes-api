  },
  "item": [
    {
      "name": "01 - cadastro de usuario",
      "item": [
        {
          "name": "1.1 - Cadastrar usuário com sucesso",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Status code deve ser 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Resposta deve conter mensagem de sucesso\", function () {\r",
                  "    pm.expect(response).to.have.property(\"message\");\r",
                  "    pm.expect(response.message).to.eql(\"Cadastro realizado com sucesso\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Resposta deve retornar _id\", function () {\r",
                  "    pm.expect(response).to.have.property(\"_id\");\r",
                  "    pm.expect(response._id).to.be.a(\"string\");\r",
                  "});\r",
                  "\r",
                  "pm.environment.set(\"userId\", response._id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const email = `automationTest${Date.now()}@teste.com`;\r",
                  "\r",
                  "pm.environment.set(\"userEmail\", email);\r",
                  "pm.environment.set(\"userPassword\", \"StrongPassword123\");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nome\": \"Automacao Testes API\",\n    \"email\": \"{{userEmail}}\",\n    \"password\": \"{{userPassword}}\",\n    \"administrador\": \"true\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "description": "Não é permitido cadastrar usuário com email já utilizado"
          },
          "response": []
        },
        {
          "name": "1.2 - Cadastrar usuário com e-mail duplicado",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Cadastro com e-mail duplicado deve ser rejeitado\", function () {\r",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 409]);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Resposta deve retornar mensagem de erro\", function () {\r",
                  "    pm.expect(response).to.have.property(\"message\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"nome\": \"Usuário com email duplicado\",\r\n    \"email\": \"automationTest@teste.com\",\r\n    \"password\": \"StrongPassword123\",\r\n    \"administrador\": \"true\"\r\n}",
              "options": {
