    {
      "name": "04 - buscar usuario",
      "item": [
        {
          "name": "4.1 - Buscar usuário existente por ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Status code deve ser 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Resposta deve conter os dados do usuário\", function () {\r",
                  "    pm.expect(response).to.have.property(\"nome\");\r",
                  "    pm.expect(response).to.have.property(\"email\");\r",
                  "    pm.expect(response).to.have.property(\"password\");\r",
                  "    pm.expect(response).to.have.property(\"administrador\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"ID retornado deve ser o mesmo utilizado na busca\", function () {\r",
                  "    pm.expect(pm.variables.replaceIn(\"{{userId}}\")).to.eql(response._id);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
