                  "});\r",
                  "\r",
                  "pm.test(\"Resposta deve conter token de autorização\", function () {\r",
                  "    pm.expect(response).to.have.property(\"authorization\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Token deve ser uma string\", function () {\r",
                  "    pm.expect(response.authorization).to.be.a(\"string\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Token não deve estar vazio\", function () {\r",
                  "    pm.expect(response.authorization).to.not.be.empty;\r",
                  "});\r",
                  "\r",
                  "pm.environment.set(\"token\", response.authorization);"
